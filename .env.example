# CineBook Environment Configuration

# Neon Serverless PostgreSQL (from Vercel Marketplace)
# Pooled URL for serverless application requests
DATABASE_URL=postgresql://neondb_owner:npg_samplepassword@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Unpooled Direct URL for migrations & Drizzle Kit
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:npg_samplepassword@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Secret (min 32 chars)
JWT_SECRET=cinebook_super_secret_jwt_key_development_32chars_min!

# Vercel Cron Secret (for securing scheduled hold release endpoints)
CRON_SECRET=cinebook_cron_secret_auth_token_for_maintenance_jobs

# Payment Webhook Secret (Stripe / Test Gateway)
PAYMENT_WEBHOOK_SECRET=whsec_test_secret_for_cinebook_payment_webhooks
